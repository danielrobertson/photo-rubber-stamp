<section id="desk" class="mx-auto w-full max-w-4xl px-5 sm:px-8">
	<div id="card-wrap" class="settle" style="--tilt:0deg; --delay:.1s">
		<!-- Filing tabs tucked behind the card's top edge -->
		<div class="flex items-end justify-between px-5 sm:px-9">
			<button id="upload-btn" type="button" class="tab">
				<span class="text-verm" aria-hidden="true">▸</span> File a photo
			</button>
			<button id="download-btn" type="button" class="tab">
				Keep the card <span class="text-verm" aria-hidden="true">▸</span>
			</button>
		</div>
		<input id="photo-input" type="file" accept="image/*" class="sr-only" />

	<!-- The specimen card: photo left, field note on paper right -->
	<figure
		id="specimen-card"
		class="relative z-10 grid overflow-hidden rounded-xl border border-ink/15 shadow-lift lg:grid-cols-2"
	>
		<div id="photo-panel" class="relative aspect-[4/3] bg-spruce lg:aspect-auto">
			<img id="photo" alt="Filed photo" class="absolute inset-0 h-full w-full object-cover" />
			<img
				id="photo-blur"
				alt=""
				aria-hidden="true"
				class="absolute inset-0 h-full w-full object-cover"
			/>
		</div>
		<figcaption
			id="paper"
			class="relative flex min-h-96 flex-col items-center justify-center px-8 py-16 sm:px-12 lg:min-h-[30rem]"
		>
			<p id="processing" hidden class="text-[13px] tracking-[0.2em] text-olive uppercase">
				Examining specimen<span class="dots"></span>
			</p>
			<div id="print-wrap" class="w-3/5 max-w-70">
				<canvas id="print" width="560" height="560" class="block w-full mix-blend-multiply"
					aria-hidden="true"></canvas>
				<div class="mt-8 space-y-1.5 text-[15px] tracking-[0.08em] text-ink/85">
					<p id="line-title" class="min-h-[1.4em] font-bold"></p>
					<p id="line-no" class="min-h-[1.4em]"></p>
					<p id="line-tags" class="min-h-[1.4em]"></p>
					<p id="line-year" class="min-h-[1.4em]"></p>
				</div>
			</div>
		</figcaption>
	</figure>
	</div>

	<p
		id="caption"
		class="rise mt-4 text-center text-[11px] tracking-[0.2em] text-olive uppercase"
		style="--delay:.35s"
	>
		Sample specimen · drop a photo anywhere
	</p>

	<p id="upload-status" class="sr-only" role="status" aria-live="polite"></p>
</section>

<style>
	/* Filing tabs: manila index tabs that read as tucked behind the card's top edge.
	   Each tab is taller than it looks — the bottom .8rem hides under the card
	   (negative margin, card at z-10), so sliding up on hover reveals more tab
	   the way a real folder tab lifts out of a drawer. */
	.tab {
		position: relative;
		height: 3.4rem;
		margin-bottom: -0.8rem;
		padding: 0.6rem 1.1rem 1.4rem;
		border: 1px solid color-mix(in oklab, var(--color-ink) 22%, transparent);
		border-bottom: none;
		border-radius: 0.6rem 0.6rem 0 0;
		/* Mustard-manila stock: plain manila vanishes against the paper background */
		background-color: color-mix(in oklab, var(--color-ochre) 26%, var(--color-manila));
		background-image: var(--paper-mottle);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-spruce);
		cursor: pointer;
		transition:
			transform 160ms ease,
			color 160ms ease;
	}
	@media (min-width: 40rem) {
		.tab {
			font-size: 11px;
			letter-spacing: 0.18em;
			padding-inline: 1.4rem;
		}
	}
	.tab:hover {
		transform: translateY(-6px);
		color: var(--color-ink);
	}
	.tab:active {
		transform: translateY(-2px);
	}

	/* Dropping a photo anywhere on the page files it; the card signals it's the target */
	#specimen-card {
		transition: outline-color 150ms ease;
		outline: 2px dashed transparent;
		outline-offset: 8px;
	}
	#specimen-card.drag {
		outline-color: var(--color-verm);
	}

	/* The card is one sheet of paper: the figure paints the paper face and its mottle
	   across both halves, so the grain runs unbroken through the seam. The photo panel
	   simply thins to nothing over the last 64px and lets that sheet show through —
	   nothing is painted *over* the photo, so there is no lighter patch to spot.
	   A blurred copy of the photo cross-fades in over the last 26px, opening at 6%
	   alpha so the start of the blur has no edge.
	   Stacked layouts blend the bottom edge; side-by-side blends the right edge. */
	#specimen-card {
		background-color: var(--paper-face);
		background-image: var(--paper-mottle);
	}
	#photo-panel {
		mask-image: linear-gradient(
			to bottom,
			rgb(0 0 0 / 1) calc(100% - 64px),
			rgb(0 0 0 / 0.97) calc(100% - 54px),
			rgb(0 0 0 / 0.88) calc(100% - 42px),
			rgb(0 0 0 / 0.68) calc(100% - 30px),
			rgb(0 0 0 / 0.4) calc(100% - 20px),
			rgb(0 0 0 / 0.15) calc(100% - 12px),
			rgb(0 0 0 / 0) calc(100% - 5px)
		);
		-webkit-mask-image: linear-gradient(
			to bottom,
			rgb(0 0 0 / 1) calc(100% - 64px),
			rgb(0 0 0 / 0.97) calc(100% - 54px),
			rgb(0 0 0 / 0.88) calc(100% - 42px),
			rgb(0 0 0 / 0.68) calc(100% - 30px),
			rgb(0 0 0 / 0.4) calc(100% - 20px),
			rgb(0 0 0 / 0.15) calc(100% - 12px),
			rgb(0 0 0 / 0) calc(100% - 5px)
		);
	}
	#photo-blur {
		z-index: 1;
		pointer-events: none;
		filter: blur(8px);
		mask-image: linear-gradient(
			to bottom,
			rgb(0 0 0 / 0) calc(100% - 26px),
			rgb(0 0 0 / 0.06) calc(100% - 20px),
			rgb(0 0 0 / 0.3) calc(100% - 13px),
			rgb(0 0 0 / 0.72) calc(100% - 6px),
			rgb(0 0 0 / 1) 100%
		);
		-webkit-mask-image: linear-gradient(
			to bottom,
			rgb(0 0 0 / 0) calc(100% - 26px),
			rgb(0 0 0 / 0.06) calc(100% - 20px),
			rgb(0 0 0 / 0.3) calc(100% - 13px),
			rgb(0 0 0 / 0.72) calc(100% - 6px),
			rgb(0 0 0 / 1) 100%
		);
	}
	@media (min-width: 64rem) {
		#photo-panel {
			mask-image: linear-gradient(
				to right,
				rgb(0 0 0 / 1) calc(100% - 64px),
				rgb(0 0 0 / 0.97) calc(100% - 54px),
				rgb(0 0 0 / 0.88) calc(100% - 42px),
				rgb(0 0 0 / 0.68) calc(100% - 30px),
				rgb(0 0 0 / 0.4) calc(100% - 20px),
				rgb(0 0 0 / 0.15) calc(100% - 12px),
				rgb(0 0 0 / 0) calc(100% - 5px)
			);
			-webkit-mask-image: linear-gradient(
				to right,
				rgb(0 0 0 / 1) calc(100% - 64px),
				rgb(0 0 0 / 0.97) calc(100% - 54px),
				rgb(0 0 0 / 0.88) calc(100% - 42px),
				rgb(0 0 0 / 0.68) calc(100% - 30px),
				rgb(0 0 0 / 0.4) calc(100% - 20px),
				rgb(0 0 0 / 0.15) calc(100% - 12px),
				rgb(0 0 0 / 0) calc(100% - 5px)
			);
		}
		#photo-blur {
			mask-image: linear-gradient(
				to right,
				rgb(0 0 0 / 0) calc(100% - 26px),
				rgb(0 0 0 / 0.06) calc(100% - 20px),
				rgb(0 0 0 / 0.3) calc(100% - 13px),
				rgb(0 0 0 / 0.72) calc(100% - 6px),
				rgb(0 0 0 / 1) 100%
			);
			-webkit-mask-image: linear-gradient(
				to right,
				rgb(0 0 0 / 0) calc(100% - 26px),
				rgb(0 0 0 / 0.06) calc(100% - 20px),
				rgb(0 0 0 / 0.3) calc(100% - 13px),
				rgb(0 0 0 / 0.72) calc(100% - 6px),
				rgb(0 0 0 / 1) 100%
			);
		}
	}

	#paper {
		/* Inner shading kept off the seam edge so the photo fade stays seamless */
		box-shadow: inset 0 -70px 70px -45px rgb(38 42 32 / 0.09);
	}
	@media (min-width: 64rem) {
		#paper {
			box-shadow: inset -70px 0 70px -45px rgb(38 42 32 / 0.09);
		}
	}

	.dots::after {
		content: "";
		animation: dots 1.2s steps(1) infinite;
	}
	@keyframes dots {
		0% {
			content: "";
		}
		25% {
			content: ".";
		}
		50% {
			content: "..";
		}
		75% {
			content: "...";
		}
	}

	.typing::after {
		content: "▌";
		margin-left: 1px;
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	#print-wrap {
		opacity: 0;
	}
	#print-wrap.developed {
		opacity: 1;
	}
	@media (prefers-reduced-motion: no-preference) {
		#print-wrap.developed {
			animation: develop 0.8s ease-out both;
		}
	}
	@keyframes develop {
		from {
			opacity: 0;
			filter: blur(4px);
			transform: scale(1.02);
		}
		to {
			opacity: 1;
			filter: blur(0);
			transform: scale(1);
		}
	}
</style>

<script>
	const card = document.getElementById("specimen-card")!;
	const cardWrap = document.getElementById("card-wrap")!;
	const input = document.getElementById("photo-input") as HTMLInputElement;
	const uploadBtn = document.getElementById("upload-btn")!;
	const downloadBtn = document.getElementById("download-btn")!;
	const photo = document.getElementById("photo") as HTMLImageElement;
	const photoBlur = document.getElementById("photo-blur") as HTMLImageElement;
	const processing = document.getElementById("processing")!;
	const printWrap = document.getElementById("print-wrap")!;
	const canvas = document.getElementById("print") as HTMLCanvasElement;
	const caption = document.getElementById("caption")!;
	const status = document.getElementById("upload-status")!;
	const lineEls = ["line-title", "line-no", "line-tags", "line-year"].map(
		(id) => document.getElementById(id)!
	);

	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	let objectUrl: string | null = null;
	let runId = 0;
	let ready = false;

	const seasons = ["WINTER", "WINTER", "SPRING", "SPRING", "SPRING", "SUMMER", "SUMMER", "SUMMER", "FALL", "FALL", "FALL", "WINTER"];
	const now = new Date();
	const seasonMark = `${seasons[now.getMonth()]} ${now.getFullYear()}`;

	const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

	function retrigger(el: HTMLElement, cls: string) {
		el.classList.remove(cls);
		void el.offsetWidth;
		el.classList.add(cls);
	}

	function nextFileNumber(): number {
		let n = 1;
		try {
			n = parseInt(localStorage.getItem("prs-no") || "0", 10) + 1;
			localStorage.setItem("prs-no", String(n));
		} catch {}
		return n;
	}

	// Posterized spruce-ink print of the photo, drawn on transparent canvas so the paper shows through
	function makePrint() {
		const ctx = canvas.getContext("2d", { willReadFrequently: true });
		const iw = photo.naturalWidth;
		const ih = photo.naturalHeight;
		if (!ctx || !iw || !ih) return;
		const size = canvas.width;
		ctx.clearRect(0, 0, size, size);
		const crop = Math.min(iw, ih);
		ctx.drawImage(photo, (iw - crop) / 2, (ih - crop) / 2, crop, crop, 0, 0, size, size);
		const image = ctx.getImageData(0, 0, size, size);
		const d = image.data;
		for (let i = 0; i < d.length; i += 4) {
			const luma = 0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2];
			const boosted = (luma - 128) * 1.4 + 128;
			let alpha;
			if (boosted > 190) alpha = 0;
			else if (boosted > 150) alpha = 70;
			else if (boosted > 105) alpha = 140;
			else if (boosted > 55) alpha = 200;
			else alpha = 255;
			if (alpha > 0) alpha += Math.random() * 30 - 15;
			d[i] = 56;
			d[i + 1] = 72;
			d[i + 2] = 62;
			d[i + 3] = Math.max(0, Math.min(255, alpha));
		}
		ctx.putImageData(image, 0, 0);
	}

	async function typeLine(el: HTMLElement, text: string, id: number) {
		el.classList.add("typing");
		for (const char of text) {
			if (runId !== id) return;
			el.textContent += char;
			await sleep(24);
		}
		el.classList.remove("typing");
	}

	async function process(src: string, opts: { instant?: boolean; lines?: string[] } = {}) {
		const { instant = false, lines: preset } = opts;
		const id = ++runId;
		ready = false;
		photo.src = src;
		photoBlur.src = src;
		processing.hidden = instant;
		printWrap.classList.remove("developed");
		lineEls.forEach((el) => {
			el.textContent = "";
			el.classList.remove("typing");
		});
		if (!instant) status.textContent = "Photo received. Examining specimen.";

		try {
			await photo.decode();
		} catch {}
		if (runId !== id) return;
		makePrint();

		if (!instant) {
			await sleep(reduced ? 200 : 1500);
			if (runId !== id) return;
		}
		processing.hidden = true;
		printWrap.classList.add("developed");

		// Placeholder field notes until Cloudflare AI writes the real ones
		const lines = preset ?? [
			"SPECIMEN",
			`No. ${String(nextFileNumber()).padStart(2, "0")}`,
			"light / shape / time",
			seasonMark,
		];
		if (instant || reduced) {
			lineEls.forEach((el, i) => (el.textContent = lines[i]));
		} else {
			await sleep(400);
			for (let i = 0; i < lines.length; i++) {
				if (runId !== id) return;
				await typeLine(lineEls[i], lines[i], id);
			}
		}
		ready = true;
		status.textContent = "Field note ready.";
	}

	function setPhoto(file: File) {
		if (!file.type.startsWith("image/")) {
			status.textContent = "That file isn't an image. Drop a photo instead.";
			return;
		}
		if (objectUrl) URL.revokeObjectURL(objectUrl);
		objectUrl = URL.createObjectURL(file);
		caption.textContent = "Your specimen, filed";
		retrigger(cardWrap, "settle");
		process(objectUrl);
	}

	// Flatten the card — photo, print, and typed lines — into one PNG
	async function download() {
		if (!ready) {
			status.textContent = "Still examining the specimen — one moment.";
			return;
		}
		const W = 1800;
		const H = 900;
		const out = document.createElement("canvas");
		out.width = W;
		out.height = H;
		const ctx = out.getContext("2d");
		const iw = photo.naturalWidth;
		const ih = photo.naturalHeight;
		if (!ctx || !iw || !ih) return;

		try {
			await Promise.all([
				document.fonts.load('700 27px "Courier Prime"'),
				document.fonts.load('27px "Courier Prime"'),
			]);
		} catch {}

		ctx.beginPath();
		ctx.roundRect(0, 0, W, H, 28);
		ctx.clip();

		// Paper face across the whole sheet
		ctx.fillStyle = "#f4efdf";
		ctx.fillRect(0, 0, W, H);

		// Photo on the left, centre-cropped square
		const crop = Math.min(iw, ih);
		ctx.drawImage(photo, (iw - crop) / 2, (ih - crop) / 2, crop, crop, 0, 0, H, H);

		// Fade the photo's right edge into the paper, echoing the on-screen seam
		const seam = ctx.createLinearGradient(H - 80, 0, H, 0);
		seam.addColorStop(0, "rgba(244, 239, 223, 0)");
		seam.addColorStop(1, "rgba(244, 239, 223, 1)");
		ctx.fillStyle = seam;
		ctx.fillRect(H - 80, 0, 80, H);

		// The print and its field notes on the right half
		const cx = H + (W - H) / 2;
		ctx.drawImage(canvas, cx - 220, 130, 440, 440);
		ctx.textAlign = "center";
		ctx.fillStyle = "rgba(38, 42, 32, 0.85)";
		try {
			(ctx as any).letterSpacing = "2px";
		} catch {}
		const texts = lineEls.map((el) => el.textContent || "");
		ctx.font = '700 27px "Courier Prime", monospace';
		ctx.fillText(texts[0], cx, 662);
		ctx.font = '27px "Courier Prime", monospace';
		texts.slice(1).forEach((t, i) => ctx.fillText(t, cx, 706 + i * 44));

		const slug = (texts[0] || "specimen").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "specimen";
		const a = document.createElement("a");
		a.download = `field-note-${slug}.png`;
		a.href = out.toDataURL("image/png");
		a.click();
		status.textContent = "Card downloaded.";
	}

	uploadBtn.addEventListener("click", () => input.click());
	downloadBtn.addEventListener("click", download);

	input.addEventListener("change", () => {
		const file = input.files?.[0];
		if (file) setPhoto(file);
	});

	// Dropping a photo anywhere on the page files it
	for (const type of ["dragenter", "dragover"]) {
		window.addEventListener(type, (event) => {
			event.preventDefault();
			card.classList.add("drag");
		});
	}
	window.addEventListener("dragleave", (event: DragEvent) => {
		if (!event.relatedTarget) card.classList.remove("drag");
	});
	window.addEventListener("drop", (event: DragEvent) => {
		event.preventDefault();
		card.classList.remove("drag");
		const file = event.dataTransfer?.files?.[0];
		if (file) setPhoto(file);
	});

	// The sample specimen, already examined and filed
	const sampleLines = ["COLOSSEUM", "No. 01", "travertine / arches / low sun", seasonMark];

	// ?demo replays the full examination on the sample
	if (new URLSearchParams(location.search).has("demo")) {
		process("/colosseum.jpg", { lines: sampleLines });
	} else {
		process("/colosseum.jpg", { instant: true, lines: sampleLines });
	}
</script>
