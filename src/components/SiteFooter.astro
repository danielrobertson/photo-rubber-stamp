---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t-2 border-ink">
	<div class="mt-[2px] border-t border-ink"></div>
	<p
		class="mx-auto max-w-6xl px-5 py-6 text-center text-[11px] tracking-[0.18em] text-olive uppercase sm:px-8"
	>
		© {year} Image to Field Notes · Made in ATX by
		<a
			href="https://danielrobertson.dev"
			target="_blank"
			rel="noopener noreferrer"
			class="underline decoration-olive/40 underline-offset-2 hover:text-verm"
		>
			danielrobertson
		</a>
	</p>
</footer>
