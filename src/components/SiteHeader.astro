---
import StampMark from "./StampMark.astro";

const now = new Date();
const seasons = ["WINTER", "WINTER", "SPRING", "SPRING", "SPRING", "SUMMER", "SUMMER", "SUMMER", "FALL", "FALL", "FALL", "WINTER"];
const seasonMark = `${seasons[now.getMonth()]} ${now.getFullYear()}`;
---

<header class="border-b-2 border-ink">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
		<a href="/" class="flex items-center gap-3">
			<StampMark class="h-9 w-9 text-verm" center="PRS" />
			<span class="font-display text-sm font-extrabold tracking-[0.18em] uppercase"
				>Photo Rubber Stamp</span
			>
		</a>
		<p class="hidden text-[11px] font-bold tracking-[0.22em] text-spruce uppercase min-[420px]:block">
			{seasonMark}
		</p>
	</div>
	<div class="h-[3px] border-t border-ink"></div>
</header>
